<Project Sdk="Microsoft.NET.Sdk">
  <!-- Walidator plików .docx względem schematu Office (Open XML SDK Microsoftu).
       Narzędzie TESTOWE na komputerze dewelopera — nie jest częścią aplikacji (nie trafia do dist/). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.*" />
  </ItemGroup>
</Project>
