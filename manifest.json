{
  "name": "Documents Workbench",
  "short_name": "Docs Workbench",
  "start_url": ".",
  "display": "standalone",
  "background_color": "#e8ecf4",
  "theme_color": "#185abd",
  "icons": [
    {
      "src": "assets/images/favicon.png",
      "sizes": "64x64",
      "type": "image/png"
    },
    {
      "src": "assets/images/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "assets/images/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./?open=file",
      "accept": {
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "application/pdf": [
          ".pdf"
        ]
      },
      "launch_type": "multiple-clients"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".docx",
            "application/pdf",
            ".pdf"
          ]
        }
      ]
    }
  }
}
