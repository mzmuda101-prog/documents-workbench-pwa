{
  "name": "Documents Workbench",
  "short_name": "Docs Workbench",
  "start_url": ".",
  "display": "standalone",
  "background_color": "#e8ecf4",
  "theme_color": "#185abd",
  "icons": [
    {
      "src": "assets/images/favicon.png?v=20261114-logo",
      "sizes": "64x64",
      "type": "image/png"
    },
    {
      "src": "assets/images/icon-192.png?v=20261114-logo",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "assets/images/icon-512.png?v=20261114-logo",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/icon-maskable-192.png?v=20261114-logo",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/images/icon-maskable-512.png?v=20261114-logo",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./?open=file",
      "accept": {
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/png": [
          ".png"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/heic": [
          ".heic"
        ],
        "image/heif": [
          ".heif"
        ]
      },
      "launch_type": "multiple-clients"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".docx",
            "application/pdf",
            ".pdf",
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/heic",
            "image/heif",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".heic",
            ".heif"
          ]
        }
      ]
    }
  }
}
